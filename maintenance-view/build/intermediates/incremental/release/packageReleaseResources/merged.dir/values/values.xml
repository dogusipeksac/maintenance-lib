<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="default_maintenance_message">Uygulama şu anda bakımdadır</string>
    <string name="default_maintenance_title">Bakım Modu</string>
    <string name="default_retry_button">Tekrar Dene</string>
    <string name="maintenance_icon_description">Bakım ikonu</string>
    <style name="MaintenanceMessage">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?android:textColorSecondary</item>
    </style>
    <style name="MaintenanceTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>
    <style name="Theme.MaintenanceMode" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <declare-styleable name="MaintenanceView">
        <attr format="string" name="maintenanceTitle"/>
        <attr format="string" name="maintenanceMessage"/>
        <attr format="reference" name="maintenanceIcon"/>
        <attr format="boolean" name="showRetryButton"/>
        <attr format="string" name="retryButtonText"/>
        <attr format="color" name="maintenanceBackgroundColor"/>
        <attr format="color" name="maintenanceTitleColor"/>
        <attr format="color" name="maintenanceMessageColor"/>
    </declare-styleable>
</resources>